# ─────────────────────────────────────────────────────────────
# Variables de entorno — cyberedu-mx
#
# LOCAL:  copia este archivo a `.env.local` y rellena los valores.
#         `.env.local` NUNCA se sube al repo (está en .gitignore).
#
# VERCEL: cada variable debe existir también en
#         Project → Settings → Environment Variables,
#         marcada al menos para el entorno **Production**.
#         Las funciones de `api/` NO leen `.env.local` en producción:
#         solo leen lo que esté configurado en Vercel.
#         Tras añadir o cambiar una variable hay que REDESPLEGAR.
# ─────────────────────────────────────────────────────────────

# ── IA: DeepSeek (generar-ejercicios, video-content, ai-chat, practica-subindice)
# Sin esta variable /api/generar-ejercicios responde 503 y la sección
# "Practica más" del simulador no muestra ejercicios.
DEEPSEEK_API_KEY=

# Opcional: fuerza un modelo concreto. Si se omite se prueban
# deepseek-v4-flash y deepseek-chat automáticamente.
# DEEPSEEK_MODEL=deepseek-chat

# ── IA: Claude (api/ai-chat.ts lo usa como respaldo cuando DeepSeek falla)
ANTHROPIC_API_KEY=

# ── Supabase (servidor)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_SERVICE_KEY=
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_SUPABASE_PROJECT_ID=
VITE_SUPABASE_PUBLISHABLE_KEY=

# ── Caché (Upstash Redis) — opcional, se usa en api/video-content.ts
KV_REST_API_URL=
KV_REST_API_TOKEN=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ── Pagos (Mercado Pago)
MP_ACCESS_TOKEN=

# ── Correo (Resend)
RESEND_API_KEY=

# ── Notificaciones push (Web Push / VAPID)
VAPID_PRIVATE_KEY=
VITE_VAPID_PUBLIC_KEY=

# ── Telegram
TELEGRAM_BOT_TOKEN=
VITE_TELEGRAM_BOT_TOKEN=

# ── WhatsApp / ManyChat
MANYCHAT_API_KEY=

# ── Seguridad y crons
ADMIN_SECRET=
VITE_ADMIN_SECRET=
CRON_SECRET=
REACTIVATION_SEND_SECRET=

# ── URL pública de la app
APP_URL=https://www.cyberedumx.com
