{
  "headers": [
    {
      "source": "/~oauth/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/((?!~oauth|api).*)",
      "destination": "/index.html"
    }
  ]
}