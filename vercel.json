{
  "buildCommand": "NODE_OPTIONS=--max-old-space-size=4096 npm run build",
  "crons": [
    {
      "path": "/api/telegram-cron",
      "schedule": "0 13 * * *"
    }
  ],
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        {
          "key": "Access-Control-Allow-Origin",
          "value": "https://www.cyberedumx.com"
        },
        {
          "key": "Access-Control-Allow-Methods",
          "value": "GET,OPTIONS,PATCH,DELETE,POST,PUT"
        },
        {
          "key": "Access-Control-Allow-Headers",
          "value": "X-CSRF-Token, X-Requested-With, Accept, Accept-Version, Content-Length, Content-MD5, Content-Type, Date, X-Api-Version, Authorization"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "X-XSS-Protection",
          "value": "1; mode=block"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=31536000; includeSubDomains; preload"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(), interest-cohort=()"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval' https://*.vercel-scripts.com https://*.mercadopago.com https://*.google-analytics.com https://www.googletagmanager.com https://cdn.jsdelivr.net https://www.youtube.com https://s.ytimg.com https://*.clarity.ms blob:; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://cdn.jsdelivr.net; font-src 'self' data: https://fonts.gstatic.com https://cdn.jsdelivr.net; img-src 'self' data: blob: https: https://*.clarity.ms; media-src 'self' blob: https: data:; connect-src 'self' https://*.supabase.co wss://*.supabase.co https://*.mercadopago.com https://*.google-analytics.com https://www.googletagmanager.com https://api.openai.com https://api.anthropic.com https://*.upstash.io https://api.resend.com https://t.me https://raw.githubusercontent.com https://www.youtube.com https://*.clarity.ms https://c.bing.com; frame-src 'self' https://*.mercadopago.com https://www.youtube.com https://youtube.com https://player.vimeo.com; worker-src 'self' blob:; child-src 'self' blob:;"
        }
      ]
    },
    {
      "source": "/sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        },
        {
          "key": "Service-Worker-Allowed",
          "value": "/"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/(.*)",
      "has": [{ "type": "host", "value": "cyberedumx.com" }],
      "destination": "https://www.cyberedumx.com/$1",
      "permanent": true
    },
    {
      "source": "/(.*)",
      "has": [{ "type": "host", "value": "cyberedu-mx.vercel.app" }],
      "destination": "https://www.cyberedumx.com/$1",
      "permanent": true
    },
    { "source": "/ecoems2026.php",                                          "destination": "/simulador-pro",    "permanent": true },
    { "source": "/ecoems20261.php",                                         "destination": "/simulador-pro",    "permanent": true },
    { "source": "/ecoemsvol1.php",                                          "destination": "/simulador-pro",    "permanent": true },
    { "source": "/ecoems1.php",                                             "destination": "/simulador-pro",    "permanent": true },
    { "source": "/ecoems2026/simuladores/simulador_completo.php",           "destination": "/simulador-pro",    "permanent": true },
    { "source": "/simulador_completo.html",                                 "destination": "/simulador-pro",    "permanent": true },
    { "source": "/simulador-ecoems-completo",                               "destination": "/simulador-pro",    "permanent": true },
    { "source": "/curso/ecoems-2026-estrategia-inteligente",                "destination": "/simulador-pro",    "permanent": true },
    { "source": "/curso/ecoems-2026/:path*",                                "destination": "/simulador-pro",    "permanent": true },
    { "source": "/(.*\\.php)",  "destination": "https://cdn.cyberedumx.com/$1", "permanent": false },
    { "source": "/(.*\\.pdf)",  "destination": "https://cdn.cyberedumx.com/$1", "permanent": false },
    { "source": "/(.*\\.py)",   "destination": "https://cdn.cyberedumx.com/$1", "permanent": false },
    { "source": "/(.*\\.sql)",  "destination": "https://cdn.cyberedumx.com/$1", "permanent": false },
    { "source": "/(.*\\.csv)",  "destination": "https://cdn.cyberedumx.com/$1", "permanent": false },

    { "source": "/ingles.html",                                             "destination": "/area/habilidades", "permanent": true },
    { "source": "/curso/ingles",                                            "destination": "/area/habilidades", "permanent": true },
    { "source": "/preguntas-frecuentes-ecoems",                             "destination": "/",                 "permanent": true },
    { "source": "/dashboard.html",                                          "destination": "/master-admin",     "permanent": true },
    { "source": "/dashboard",                                               "destination": "/master-admin",     "permanent": true }
  ],
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/$1" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
